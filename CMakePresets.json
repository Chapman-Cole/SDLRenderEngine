{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "description": "Builds x64 debug version of project",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "OFF"
      },
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "description": "Builds x64 release version of project",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_ASAN": "OFF"
      },
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "windows-asan",
      "displayName": "Windows x64 Asan build",
      "description": "Builds x64 debug version with address sanitization",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "ON"
      },
      "binaryDir": "${sourceDir}/build/asan"
    },
    {
      "name": "linux-release",
      "displayName": "Linux x64 Release",
      "description": "Builds x64 release version of project",
      "generator": "Unix Makefiles",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_ASAN": "OFF"
      },
      "binaryDir": "${sourceDir}/build/release"
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x64 Debug",
      "description": "Builds x64 debug version of project",
      "generator": "Unix Makefiles",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "OFF"
      },
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "linux-asan",
      "displayName": "Linux x64 Asan Build",
      "description": "Linux x64 debug version with address sanitization",
      "generator": "Unix Makefiles",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_ASAN": "ON"
      },
      "binaryDir": "${sourceDir}/build/asan"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan"
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan"
    }
  ]
}